# ─────────────────────────────────────────────────────────────
# Mira backend keys — copy this file to .env and fill in values.
#   cp .env.example .env
#   npm run build
#   node server/index.mjs
#
# These keys stay on the server and are NEVER sent to the browser.
# ─────────────────────────────────────────────────────────────

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=

# GroqCloud → https://console.groq.com/keys
GROQ_API_KEY=

# Port for the app + API (default 3000)
PORT=3000

# Host to bind (0.0.0.0 is fine for most hosts)
HOST=0.0.0.0

# Optional: extra browser origins allowed to call this backend, comma separated.
# Localhost origins are always allowed for development.
# ALLOWED_ORIGINS=https://your-site.example.com

# ─────────────────────────────────────────────────────────────
# Image Studio needs NO key. It uses Pollinations' free, keyless
# image API (https://image.pollinations.ai). Nothing to configure.
# ─────────────────────────────────────────────────────────────
